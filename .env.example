# ==============================================================================
# UMEED Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to .env.local (in project root or apps/web/.env.local)
#    Command: cp .env.example .env.local
# 2. For local zero-dependency testing, leave MONGODB_URI blank to use the
#    built-in high-fidelity InMemoryIncidentRepository.
# 3. For persistent database integration, supply your real MongoDB Atlas URI.
#
# SECURITY: NEVER commit real credentials, API keys, or secrets to Git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_NAME="UMEED"

# ------------------------------------------------------------------------------
# 2. Database Configuration (MongoDB Atlas)
# ------------------------------------------------------------------------------
# Leave MONGODB_URI empty to run with zero-setup in-memory repository fallback.
# When ready for Atlas, uncomment and paste your real cluster connection string:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://punarvashu_db_user:<db_password>@cluster0.lhqnclv.mongodb.net/
MONGODB_DB=UMEED

# ------------------------------------------------------------------------------
# 3. Security & Access Control (Phase 2.1 & Phase 2.2)
# ------------------------------------------------------------------------------
# Pre-shared keys for Coordinator triage queue and Crawler service ingestion.
# Default development keys ('umeed-coordinator-dev-key', 'umeed-crawler-dev-key')
# are accepted ONLY when NODE_ENV=development or test.
# In production (NODE_ENV=production), strong unpredictable secrets (min 16 chars)
# MUST be configured; production strictly rejects development defaults and placeholders.
COORDINATOR_API_KEY=umeed-coordinator-dev-key
CRAWLER_API_KEY=umeed-crawler-dev-key

# ------------------------------------------------------------------------------
# 4. AI Multimodal Triage (Google Gemini) - Required for Phase 3
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio (https://aistudio.google.com/)
# GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Persistent Coordination Memory (Meko) - Required for Phase 6
# ------------------------------------------------------------------------------
# MEKO_API_KEY=
# MEKO_DATAPACK_ID=

# ------------------------------------------------------------------------------
# 6. Historical Impact Analytics (IOMETE) - Required for Phase 7
# ------------------------------------------------------------------------------
# IOMETE_PAT=
# IOMETE_EVENT_STREAM_URL=https://workspace.iomete.cloud/api/v1/event-stream

# ------------------------------------------------------------------------------
# 7. Social Media Distress Discovery Crawler (FastAPI) - Required for Phase 8
# ------------------------------------------------------------------------------
DISCOVERY_SERVICE_URL=http://localhost:8000
