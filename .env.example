# ==============================================================================
# UMEED Environment Configuration Template (.env.example)
#
# IMPORTANT: Copy this file to .env.local for local development.
# NEVER commit real credentials, access tokens, or connection strings to Git.
# ==============================================================================

# Application Runtime
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_NAME="UMEED"

# Database Configuration (MongoDB Atlas)
# Leave empty in early development if testing health checks without Atlas.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=umeed_dev

# AI Multimodal Triage (Google Gemini) - Required for Phase 3
GEMINI_API_KEY=your_gemini_api_key_placeholder

# Persistent Coordination Memory (Meko) - Required for Phase 6
MEKO_API_KEY=your_meko_api_key_placeholder
MEKO_DATAPACK_ID=your_meko_datapack_id_placeholder

# Historical Impact Analytics (IOMETE) - Required for Phase 7
IOMETE_PAT=your_iomete_pat_placeholder
IOMETE_EVENT_STREAM_URL=https://workspace.iomete.cloud/api/v1/event-stream

# Social Media Distress Discovery Crawler (FastAPI) - Required for Phase 8
DISCOVERY_SERVICE_URL=http://localhost:8000

