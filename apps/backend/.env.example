# ==============================================================================
# UMEED Fastify Backend — Environment Configuration (.env.example)
# Target: Fly.io Mumbai (bom) / Local Fastify Development
# ==============================================================================

NODE_ENV=development
PORT=8080
HOST=0.0.0.0
FLY_REGION=bom

# Primary Persistent Storage (MongoDB Atlas AWS ap-south-1 Mumbai)
# Leave empty for local zero-dependency testing (fails closed on /ready)
MONGODB_URI=
MONGODB_DB=umeed_db

# BFF Proxy Inter-Service Authentication (Vercel Next.js <-> Fly.io Fastify)
# Must match UMEED_PROXY_SIGNING_SECRET in apps/web/.env.local and Vercel project env
UMEED_PROXY_SIGNING_SECRET=

# External API Credentials
GEMINI_API_KEY=
COORDINATOR_API_KEY=
CRAWLER_API_KEY=

