{
  "name": "umeed",
  "version": "0.1.0",
  "private": true,
  "description": "UMEED — AI-powered social distress discovery and closed-loop assistance coordination platform",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "dev:umeed": "npm run dev --workspace=apps/web",
    "build:umeed": "npm run build --workspaces --if-present",
    "lint:umeed": "npm run lint --workspaces --if-present",
    "typecheck:umeed": "npm run typecheck --workspaces --if-present",
    "test:umeed": "npm run test --workspaces --if-present",
    "seed:demo": "npx tsx --tsconfig=apps/web/tsconfig.json --env-file=apps/web/.env.local scripts/seed-demo.ts",
    "reset:demo": "npx tsx --tsconfig=apps/web/tsconfig.json --env-file=apps/web/.env.local scripts/reset-demo.ts"
  },
  "keywords": [
    "umeed",
    "carelink",
    "social-distress",
    "ai-coordination",
    "hackcbs"
  ],
  "author": "UMEED Team",
  "license": "MIT",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "postcss": "8.5.32"
  }
}
